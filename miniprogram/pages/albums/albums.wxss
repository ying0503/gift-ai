page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f0f2f5;
}
.scrollarea { flex: 1; }
.page { padding: 16rpx; }

.empty {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 48rpx 0;
}

.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,.06);
}

.card-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.album-card {
  width: calc(50% - 6rpx);
  padding: 12rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
  box-sizing: border-box;
}
.album-img {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 6rpx;
}
.album-info {
  font-size: 22rpx;
  color: #666;
  margin-top: 8rpx;
  line-height: 1.6;
}
.album-date { color: #999; }
.prompt-row {
  position: relative;
  margin-top: 8rpx;
  padding-right: 36rpx;
}
.prompt-text {
  font-size: 20rpx;
  color: #888;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  word-break: break-word;
}
.copy-icon {
  position: absolute;
  right: 0;
  top: 0;
  font-size: 20rpx;
  color: #999;
}

.pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
  margin-bottom: 32rpx;
}
.page-btn {
  padding: 8rpx 24rpx;
  border: 1px solid #d9d9d9;
  border-radius: 8rpx;
  font-size: 24rpx;
  background: #fff;
  color: #333;
  line-height: 2;
}
.page-btn[disabled] { opacity: .4; }
.page-info {
  font-size: 24rpx;
  color: #666;
}
