page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f0f2f5;
}
.scrollarea { flex: 1; }
.page { padding: 16rpx; }

.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,.06);
}

.user-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 24rpx;
}
.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #1a1a2e;
  color: #fff;
  font-size: 40rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}
.email {
  font-size: 28rpx;
  color: #333;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  background: #e74c3c;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  line-height: 88rpx;
  text-align: center;
}
