page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f0f2f5;
}
.scrollarea {
  flex: 1;
}
.form {
  padding: 48rpx 32rpx;
  max-width: 400px;
  margin: 0 auto;
  width: 100%;
  box-sizing: border-box;
}
.title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1a1a2e;
  text-align: center;
  margin-bottom: 48rpx;
}
.input {
  width: 100%;
  height: 88rpx;
  background: #fff;
  border: 1px solid #d9d9d9;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}
.btn {
  width: 100%;
  height: 88rpx;
  background: #1a1a2e;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  line-height: 88rpx;
  text-align: center;
  margin-top: 16rpx;
}
.toggle {
  text-align: center;
  color: #1a1a2e;
  font-size: 26rpx;
  margin-top: 32rpx;
  text-decoration: underline;
}
.error {
  color: #e74c3c;
  text-align: center;
  font-size: 26rpx;
  margin-top: 16rpx;
}
