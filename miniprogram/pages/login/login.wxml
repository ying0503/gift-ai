<navigation-bar title="登录" back="{{false}}" color="black" background="#FFF"></navigation-bar>
<scroll-view class="scrollarea" scroll-y>
  <view class="form">
    <view class="title">{{isRegister ? '注册' : '登录'}}</view>
    <input class="input" placeholder="邮箱" type="text" value="{{email}}" bindinput="onEmailInput" />
    <input class="input" placeholder="密码" type="password" value="{{password}}" bindinput="onPasswordInput" />
    <button class="btn" bindtap="submit" loading="{{loading}}">{{isRegister ? '注册' : '登录'}}</button>
    <view class="toggle" bindtap="toggleMode">{{isRegister ? '已有账号？去登录' : '没有账号？去注册'}}</view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
  </view>
</scroll-view>
