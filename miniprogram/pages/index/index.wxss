page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f0f2f5;
}
.scrollarea {
  flex: 1;
}
.page {
  padding: 16rpx;
}

/* Card */
.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,.06);
}
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}
.import-btn {
  font-size: 24rpx;
  color: #1a1a2e;
  font-weight: 500;
}

/* Textarea */
.textarea {
  width: 100%;
  height: 300rpx;
  padding: 16rpx;
  font-size: 24rpx;
  color: #333;
  border: 1px solid #d9d9d9;
  border-radius: 8rpx;
  background: #fff;
  box-sizing: border-box;
  line-height: 1.6;
}

/* Config */
.config-row {
  display: flex;
  gap: 16rpx;
}
.config-item {
  flex: 1;
  min-width: 0;
}
.label {
  display: block;
  font-size: 22rpx;
  color: #888;
  margin-bottom: 8rpx;
}
.picker {
  width: 100%;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 16rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Reference images */
.ref-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.ref-item {
  position: relative;
  width: 120rpx;
  height: 120rpx;
}
.ref-img {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}
.ref-del {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 32rpx;
  height: 32rpx;
  background: rgba(0,0,0,.3);
  color: #fff;
  border-radius: 50%;
  text-align: center;
  line-height: 32rpx;
  font-size: 24rpx;
}

/* Generate button */
.generate-btn {
  width: 100%;
  height: 88rpx;
  background: #1a1a2e;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  line-height: 88rpx;
  text-align: center;
  margin-bottom: 24rpx;
}
.generate-btn[disabled] {
  opacity: .5;
}

/* Section title */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}
.empty {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 48rpx 0;
}

/* Card grid */
.card-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.album-card {
  width: calc(50% - 6rpx);
  padding: 12rpx;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  min-width: 0;
  box-sizing: border-box;
}
.album-img {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 6rpx;
}
.loading-wrap {
  width: 100%;
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fafafa;
  border-radius: 6rpx;
}
.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #1a1a2e;
  border-radius: 50%;
  animation: spin .8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.percent {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-top: 12rpx;
}
.album-info {
  font-size: 22rpx;
  color: #666;
  margin-top: 8rpx;
  line-height: 1.6;
}
.album-date {
  color: #999;
}
.prompt-row {
  position: relative;
  margin-top: 8rpx;
  padding-right: 36rpx;
}
.prompt-text {
  font-size: 20rpx;
  color: #888;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  word-break: break-word;
}
.copy-icon {
  position: absolute;
  right: 0;
  top: 0;
  width: 28rpx;
  height: 28rpx;
}

/* Pagination */
.pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
  margin-bottom: 32rpx;
}
.page-btn {
  padding: 8rpx 24rpx;
  border: 1px solid #d9d9d9;
  border-radius: 8rpx;
  font-size: 24rpx;
  background: #fff;
  color: #333;
  line-height: 2;
}
.page-btn[disabled] {
  opacity: .4;
}
.page-info {
  font-size: 24rpx;
  color: #666;
}
