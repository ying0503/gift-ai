<scroll-view class="scrollarea" scroll-y type="list">
  <view class="page">

    <!-- 提示词 -->
    <view class="card">
      <view class="card-header">
        <text class="card-title">提示词</text>
        <text class="import-btn" bindtap="importExcel">导入 Excel</text>
      </view>
      <textarea class="textarea" value="{{promptText}}" bindinput="onPromptInput" placeholder="请输入提示词" maxlength="-1" />
    </view>

    <!-- 配置 -->
    <view class="card">
      <view class="config-row">
        <view class="config-item">
          <text class="label">比例</text>
          <picker mode="selector" range="{{ratios}}" value="{{sizeIndex}}" bindchange="onSizeChange">
            <view class="picker">{{ratios[sizeIndex]}}</view>
          </picker>
        </view>
        <view class="config-item">
          <text class="label">分辨率</text>
          <picker mode="selector" range="{{resolutions}}" value="{{resIndex}}" bindchange="onResChange">
            <view class="picker">{{resolutions[resIndex]}}</view>
          </picker>
        </view>
        <view class="config-item">
          <text class="label">模型</text>
          <picker mode="selector" range="{{models}}" value="{{modelIndex}}" bindchange="onModelChange">
            <view class="picker">{{models[modelIndex]}}</view>
          </picker>
        </view>
      </view>
    </view>

    <!-- 参考图片 -->
    <view class="card">
      <view class="card-header">
        <text class="card-title">参考图片</text>
        <text class="import-btn" bindtap="uploadRef">+ 上传</text>
      </view>
      <view class="ref-list">
        <view wx:for="{{refImages}}" wx:key="index" class="ref-item">
          <image src="{{item}}" mode="aspectFill" class="ref-img" />
          <text class="ref-del" data-url="{{item}}" bindtap="removeRef">×</text>
        </view>
      </view>
    </view>

    <!-- 生成按钮 -->
    <button class="generate-btn" disabled="{{!canGenerate || generating}}" bindtap="handleGenerate" loading="{{generating}}">生成画册</button>

    <!-- 生成中的卡片 -->
    <view wx:if="{{cards.length > 0}}" class="section-title">生成进度</view>
    <view class="card-grid">
      <view wx:for="{{cards}}" wx:key="id" class="card album-card" data-url="{{item.url}}" bindtap="openImage">
        <image wx:if="{{item.url}}" src="{{item.url}}" mode="aspectFill" class="album-img" />
        <view wx:elif="{{item.error}}" class="error-wrap">
          <text class="error-text">{{item.error}}</text>
        </view>
        <view wx:else class="loading-wrap">
          <text class="percent">{{item.progress}}%</text>
          <text class="status-text">{{item.statusText}}</text>
        </view>
        <view class="album-info">
          <text class="album-model">{{item.model}}</text>
          <text class="album-date">{{item.date}}</text>
        </view>
        <view wx:if="{{item.prompt}}" class="prompt-row">
          <text class="prompt-text">{{item.prompt}}</text>
          <text class="copy-icon" data-prompt="{{item.prompt}}" bindtap="copyPrompt">复制</text>
        </view>
      </view>
    </view>

  </view>
</scroll-view>
